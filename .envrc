# shellcheck shell=bash
# The rk pin is the release-kit input's tag in flake.nix, locked in
# flake.lock; `use flake` already watches both, so no extra watch is
# registered for it.
use flake

# Route each rustc call through the kache of the host. The devshell does not
# set the variable, so CI, which enters it without direnv, builds without
# kache. KACHE_DISABLED=1 runs one command without it.
export RUSTC_WRAPPER=kache

# SDD_REPO is derived from Cargo.toml, the release source of truth, so the
# repository slug is never restated anywhere else.
watch_file Cargo.toml
SDD_REPO="$(sed -n 's|^repository *= *"https://github.com/\([^"]*\)".*|\1|p' Cargo.toml | head -n 1)"
SDD_REPO="${SDD_REPO%.git}"
export SDD_REPO

# gh pages its output whenever stdout is a terminal, which stalls the
# release-setup scripts; blank disables it.
export GH_PAGER=""

# Developer-specific values load from a file outside the checkout, named
# after this repository; project-env.example is the tracked template. The
# file holds values that the operator chooses. A credential belongs behind a
# credential gateway, not in an environment variable.
project_env=$HOME/.config/project-env/spec-driven-docs.env
if [ -r "$project_env" ]; then source_env "$project_env"; fi

# The host supplies the exobrain CLI (host-requirements.toml). The first
# warning reports an old nixpkgs pin, a newer release of a tag-pinned input
# of flake.lock such as release-kit or spec-driven-docs, a newer exobrain
# CLI, and newer hook revisions than the pins of .pre-commit-config.yaml.
# The operator moves a flake pin with `flake-edit update <input>`. The second
# reports working-tree copies in the Nix store once a day, and runs prek
# cache gc once a week. Each exits 0 and moves nothing. This lives here
# rather than in the devshell's shellHook so that direnv alone runs it: CI
# enters the same shell through `nix develop` and has no business checking
# for a release.
exobrain outdated || true
exobrain store-guard --daily || true
