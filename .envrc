# The rk pin is the release-kit input's tag in flake.nix, locked in
# flake.lock; `use flake` already watches both, so no extra watch is
# registered for it.
use flake

# SDD_REPO is derived from Cargo.toml, the release source of truth, so the
# repository slug is never restated anywhere else.
watch_file Cargo.toml
SDD_REPO="$(sed -n 's|^repository *= *"https://github.com/\([^"]*\)".*|\1|p' Cargo.toml | head -n 1)"
SDD_REPO="${SDD_REPO%.git}"
export SDD_REPO

# gh pages its output whenever stdout is a terminal, which stalls the
# release-setup scripts; blank disables it.
export GH_PAGER=""

# Developer-specific values — absolute paths, credentials — live here and are
# never committed; .envrc.local.example is the tracked template.
source_env_if_exists .envrc.local

# Warn when release-kit has a newer release than the rk pin. The check reads
# its cache, refreshes it at most once a week, writes no file but its cache,
# and exits 0. It never moves the pin: the operator does that from a shell,
# with the sync verb that the warning names. This lives here rather than in the
# devshell's shellHook so that direnv alone runs it: CI enters the same shell
# through `nix develop` and has no business checking for a release.
rk self-depend check || true

# Warn when spec-driven-docs has a newer release than the sdd pin, with the
# same contract as the rk check above: the operator moves the pin.
sdd self-depend check || true

# Warn once a day about working-tree copies in the Nix store.
if command -v exobrain >/dev/null 2>&1; then exobrain store-guard --daily || true; fi
