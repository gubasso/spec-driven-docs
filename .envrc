use flake

# SDD_REPO is derived from Cargo.toml, the release source of truth, so the
# repository slug is never restated anywhere else.
watch_file Cargo.toml
SDD_REPO="$(sed -n 's|^repository *= *"https://github.com/\([^"]*\)".*|\1|p' Cargo.toml | head -n 1)"
SDD_REPO="${SDD_REPO%.git}"
export SDD_REPO

# gh pages its output whenever stdout is a terminal, which stalls the
# release-setup scripts; blank disables it.
export GH_PAGER=""

# Developer-specific values — absolute paths, credentials — live here and are
# never committed; .envrc.local.example is the tracked template.
source_env_if_exists .envrc.local
