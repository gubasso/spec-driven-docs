# The rk pin is a file the flake imports, not a lock entry, so it is
# registered before `use flake`: nix-direnv invalidates its cached shell
# against the watches it can already see, and one registered later would
# not reach that comparison until the pass after the bump.
watch_file nix/rk.nix

use flake

# SDD_REPO is derived from Cargo.toml, the release source of truth, so the
# repository slug is never restated anywhere else.
watch_file Cargo.toml
SDD_REPO="$(sed -n 's|^repository *= *"https://github.com/\([^"]*\)".*|\1|p' Cargo.toml | head -n 1)"
SDD_REPO="${SDD_REPO%.git}"
export SDD_REPO

# gh pages its output whenever stdout is a terminal, which stalls the
# release-setup scripts; blank disables it.
export GH_PAGER=""

# Developer-specific values — absolute paths, credentials — live here and are
# never committed; .envrc.local.example is the tracked template.
source_env_if_exists .envrc.local

# Report and take release-kit's latest release. This lives here rather than
# in the devshell's shellHook so that direnv alone runs it: CI enters the
# same shell through `nix develop` and has no business bumping a pin.
./scripts/rk-autobump.sh || true
