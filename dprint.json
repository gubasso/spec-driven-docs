{
  "markdown": {
    "textWrap": "never"
  },
  "json": {
    "indentWidth": 2
  },
  "includes": [
    "**/*.md",
    "**/*.json",
    "**/*.jsonc"
  ],
  "excludes": [
    ".git",
    "node_modules",
    "target",
    "CHANGELOG.md",
    "SECURITY.md",
    ".release-kit/manifest.json",
    ".spec-driven-docs/manifest.json",
    "AGENTS.md",
    "instance/payload-manifest.json",
    ".claude/skills",
    ".agents/skills",
    "third-party"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.0.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm"
  ]
}
