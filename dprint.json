{
  "markdown": {
    "textWrap": "never"
  },
  "json": {
    "indentWidth": 2
  },
  "includes": [
    "**/*.md",
    "**/*.json",
    "**/*.jsonc"
  ],
  "excludes": [
    ".git",
    "node_modules",
    "target",
    "CHANGELOG.md",
    "SECURITY.md",
    ".release-kit/manifest.json",
    ".spec-driven-docs/manifest.json",
    "instance/payload-manifest.json",
    ".claude/skills/sdd-setup",
    ".claude/skills/sdd-write-docs",
    ".claude/skills/rk-setup",
    ".claude/skills/rk-release",
    ".agents/skills/sdd-setup",
    ".agents/skills/sdd-write-docs",
    ".agents/skills/rk-setup",
    ".agents/skills/rk-release",
    "third-party"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.0.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm"
  ]
}
