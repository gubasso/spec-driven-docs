# shellcheck shell=bash
# Developer-specific values for the release-kit bot setup steps. Gitignored:
# this file names a private key on this machine and is never committed.
#
# Both are empty on purpose — rk setup guards on its own variables, so an
# unfilled value fails loudly instead of reaching the GitHub API.

# The App ID, from the "About" section of
# https://github.com/settings/apps/gubasso-ci-bot
export RK_BOT_APP_ID=''

# Absolute path to the private key downloaded from the same page, e.g.
# /home/you/Downloads/gubasso-ci-bot.2026-08-26.private-key.pem
export RK_BOT_PRIVATE_KEY_FILE=''

# Set to any value to stop the devshell from bumping the rk pin on entry.
export RK_SKIP_AUTOBUMP=''
