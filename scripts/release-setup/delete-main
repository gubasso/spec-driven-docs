#!/usr/bin/env sh
# Delete main, now that develop is the default branch and master is the
# release branch. Idempotent: an absent main is the desired state.
set -eu
cd "$(dirname "$0")/../.."
: "${SDD_REPO:?run: direnv allow (it derives the slug from Cargo.toml)}"

if git ls-remote --exit-code --heads origin main >/dev/null 2>&1; then
  gh api -X DELETE "repos/$SDD_REPO/git/refs/heads/main"
fi

echo 'check: prints nothing'
git ls-remote --heads origin main
echo 'ok delete-main'
