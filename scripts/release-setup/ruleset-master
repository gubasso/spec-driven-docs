#!/usr/bin/env sh
# Protect master, the release branch. It takes no direct push: a pull request
# carrying a passing test check is the only way in, and that is the release
# gate (ADR-cut-the-release-from-master). The merge method is a merge commit
# because GitHub offers no fast-forward merge, so a linear-history rule would
# reject every release merge and a rebase or squash would make master diverge
# from develop permanently. Nothing in the pipeline writes this branch —
# release-plz pushes a tag, which release-tags governs — so it names no bypass
# actor. Rerunning updates in place.
set -eu
cd "$(dirname "$0")/../.."
: "${SDD_REPO:?run: direnv allow (it derives the slug from Cargo.toml)}"

name=master-protection
id="$(gh api "repos/$SDD_REPO/rulesets" -q ".[] | select(.name == \"$name\") | .id" | head -n 1)"

if [ -n "$id" ]; then
  gh api -X PUT "repos/$SDD_REPO/rulesets/$id" --input - >/dev/null
else
  gh api -X POST "repos/$SDD_REPO/rulesets" --input - >/dev/null
fi <<JSON
{
  "name": "$name",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": { "include": ["refs/heads/master"], "exclude": [] }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": true,
        "strict_required_status_checks_policy": false,
        "required_status_checks": [{ "context": "test" }]
      }
    }
  ]
}
JSON

echo "ok $name"
