#!/usr/bin/env sh
# Protect develop: no force pushes, no deletion. It takes direct pushes and
# carries no required status check, because one would reject the push that
# opens a release; the release is gated on master instead. Nothing in the
# pipeline writes develop, so it needs no bypass. Rerunning updates in place.
set -eu
cd "$(dirname "$0")/../.."
: "${SDD_REPO:?run: direnv allow (it derives the slug from Cargo.toml)}"

name=develop-protection
id="$(gh api "repos/$SDD_REPO/rulesets" -q ".[] | select(.name == \"$name\") | .id" | head -n 1)"

if [ -n "$id" ]; then
  gh api -X PUT "repos/$SDD_REPO/rulesets/$id" --input - >/dev/null
else
  gh api -X POST "repos/$SDD_REPO/rulesets" --input - >/dev/null
fi <<JSON
{
  "name": "$name",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["refs/heads/develop"], "exclude": [] }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" }
  ]
}
JSON

echo "ok $name"
