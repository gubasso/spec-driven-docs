#!/usr/bin/env sh
# Create master at develop's tip, before master-protection exists, so no rule
# governs its creation. Idempotent: master is the release branch and the tags
# derive from it, so an existing master is left exactly where it is.
set -eu
cd "$(dirname "$0")/../.."
: "${SDD_REPO:?run: direnv allow (it derives the slug from Cargo.toml)}"

if git ls-remote --exit-code --heads origin master >/dev/null 2>&1; then
  echo 'ok master exists; leaving it where it is'
else
  sha="$(git ls-remote origin refs/heads/develop | cut -f 1)"
  if [ -z "$sha" ]; then
    echo 'FAIL develop does not exist on the remote' >&2
    echo 'remediation: git push origin develop' >&2
    exit 1
  fi
  gh api -X POST "repos/$SDD_REPO/git/refs" -f "ref=refs/heads/master" -f "sha=$sha" >/dev/null
  echo 'ok master created at develop'
fi

echo 'check: prints one sha for master'
git ls-remote --heads origin master
echo 'ok create-master'
