#!/usr/bin/env sh
# Store the GitHub App credentials as repository secrets. The private key
# goes in over stdin so the PEM armor and its newlines land verbatim.
set -eu
cd "$(dirname "$0")/../.."
: "${SDD_REPO:?run: direnv allow (it derives the slug from Cargo.toml)}"
: "${SDD_APP_ID:?export it in .envrc.local; the App ID is on https://github.com/settings/apps/gubasso-ci-bot}"
: "${SDD_APP_PEM:?export it in .envrc.local, pointing at the downloaded private key}"

if [ ! -f "$SDD_APP_PEM" ]; then
  echo "FAIL no such file: $SDD_APP_PEM" >&2
  echo 'remediation: point SDD_APP_PEM at the downloaded private key' >&2
  exit 1
fi

gh secret set RELEASE_PLZ_APP_ID --repo "$SDD_REPO" --body "$SDD_APP_ID"
gh secret set RELEASE_PLZ_APP_PRIVATE_KEY --repo "$SDD_REPO" <"$SDD_APP_PEM"
echo 'check: lists both secrets'
gh secret list --repo "$SDD_REPO"
