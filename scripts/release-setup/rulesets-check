#!/usr/bin/env sh
# Verify the rulesets are exactly the three these scripts own, and that
# master-protection still has the shape a release merge needs: a ruleset that
# rejects or corrupts that merge is invisible until the release merge, and a
# ruleset no script owns is protection nothing here can reproduce or explain.
set -eu
cd "$(dirname "$0")/../.."
: "${SDD_REPO:?run: direnv allow (it derives the slug from Cargo.toml)}"

names="$(gh api "repos/$SDD_REPO/rulesets" -q '.[].name' | sort)"
extra="$names"
status=0

for pair in develop-protection:ruleset-develop master-protection:ruleset-master release-tags:ruleset-tags; do
  name="${pair%%:*}"
  extra="$(printf '%s\n' "$extra" | grep -vxF "$name" || true)"
  if printf '%s\n' "$names" | grep -qxF "$name"; then
    echo "ok $name"
    continue
  fi
  echo "FAIL missing ruleset: $name" >&2
  echo "remediation: run scripts/release-setup/${pair#*:}" >&2
  status=1
done

if [ -n "$extra" ]; then
  echo 'FAIL rulesets no script owns:' >&2
  printf '%s\n' "$extra" >&2
  echo "remediation: delete each one at https://github.com/$SDD_REPO/settings/rules" >&2
  status=1
fi

id="$(gh api "repos/$SDD_REPO/rulesets" -q '.[] | select(.name=="master-protection") | .id' | head -n 1)"
if [ -n "$id" ]; then
  body="$(gh api "repos/$SDD_REPO/rulesets/$id")"
  types="$(printf '%s' "$body" | jq -r '.rules[].type')"

  for want in pull_request required_status_checks; do
    if printf '%s\n' "$types" | grep -qxF "$want"; then
      echo "ok master-protection rule: $want"
    else
      echo "FAIL master-protection has no $want rule" >&2
      echo 'remediation: run scripts/release-setup/ruleset-master' >&2
      status=1
    fi
  done

  if printf '%s\n' "$types" | grep -qxF required_linear_history; then
    echo 'FAIL master-protection still requires linear history' >&2
    echo 'remediation: GitHub offers no fast-forward merge, so the rule rejects every release merge; run scripts/release-setup/ruleset-master' >&2
    status=1
  else
    echo 'ok master-protection allows a merge commit'
  fi

  methods="$(printf '%s' "$body" | jq -r '.rules[] | select(.type=="pull_request") | .parameters.allowed_merge_methods[]?')"
  if printf '%s\n' "$methods" | grep -qxF merge; then
    echo 'ok master-protection allows the merge method'
  else
    echo 'FAIL master-protection does not allow the merge method' >&2
    echo 'remediation: rebase and squash make master diverge from develop; run scripts/release-setup/ruleset-master' >&2
    status=1
  fi
fi

[ "$status" -eq 0 ] || exit 1
echo 'ok rulesets-check'
