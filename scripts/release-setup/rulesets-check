#!/usr/bin/env sh
# Verify the rulesets are exactly the three these scripts own, and that
# master-protection still has the shape a release merge needs: a ruleset that
# rejects or corrupts that merge is invisible until the release merge, and a
# ruleset no script owns is protection nothing here can reproduce or explain.
set -eu
cd "$(dirname "$0")/../.."
: "${SDD_REPO:?run: direnv allow (it derives the slug from Cargo.toml)}"

names="$(gh api "repos/$SDD_REPO/rulesets" -q '.[].name' | sort)"
extra="$names"
status=0

for pair in develop-protection:ruleset-develop master-protection:ruleset-master release-tags:ruleset-tags; do
  name="${pair%%:*}"
  extra="$(printf '%s\n' "$extra" | grep -vxF "$name" || true)"
  if printf '%s\n' "$names" | grep -qxF "$name"; then
    echo "ok $name"
    continue
  fi
  echo "FAIL missing ruleset: $name" >&2
  echo "remediation: run scripts/release-setup/${pair#*:}" >&2
  status=1
done

if [ -n "$extra" ]; then
  echo 'FAIL rulesets no script owns:' >&2
  printf '%s\n' "$extra" >&2
  echo "remediation: delete each one at https://github.com/$SDD_REPO/settings/rules" >&2
  status=1
fi

id="$(gh api "repos/$SDD_REPO/rulesets" -q '.[] | select(.name=="master-protection") | .id' | head -n 1)"
if [ -n "$id" ]; then
  body="$(gh api "repos/$SDD_REPO/rulesets/$id")"

  check() {
    label="$1"
    expected="$2"
    remedy="$3"
    actual="$(printf '%s' "$body" | jq -r "$4")"
    if [ "$actual" = "$expected" ]; then
      echo "ok master-protection $label"
    else
      echo "FAIL master-protection $label: expected $expected, got $actual" >&2
      echo "remediation: $remedy" >&2
      status=1
    fi
  }

  rerun='run scripts/release-setup/ruleset-master'

  check 'names no bypass actor' 0 "$rerun" '.bypass_actors | length'
  check 'requires a pull request' true "$rerun" '[.rules[].type] | contains(["pull_request"])'
  check 'requires a status check' true "$rerun" '[.rules[].type] | contains(["required_status_checks"])'
  check 'allows a merge commit' false \
    'GitHub offers no fast-forward merge, so linear history rejects every release merge; '"$rerun" \
    '[.rules[].type] | contains(["required_linear_history"])'
  check 'allows only the merge method' '["merge"]' \
    'rebase and squash make master diverge from develop; '"$rerun" \
    '[.rules[] | select(.type=="pull_request") | .parameters.allowed_merge_methods] | first // [] | sort | tojson'
  check 'requires the test check' test "$rerun" \
    '[.rules[] | select(.type=="required_status_checks") | .parameters.required_status_checks[].context] | join(",")'
  check 'asks no approval for unattributed changes' false \
    'an unattributed align-manifest commit would demand an approval the rule set never asks for; '"$rerun" \
    '[.rules[] | select(.type=="pull_request") | .parameters.require_extra_approval_for_unattributed_changes] | first'
  check 'asks for no approving review' 0 "$rerun" \
    '[.rules[] | select(.type=="pull_request") | .parameters.required_approving_review_count] | first'
fi

[ "$status" -eq 0 ] || exit 1
echo 'ok rulesets-check'
