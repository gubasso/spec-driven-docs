{
  "$comment": "Every gate the canon delivers to an instance, and how it is wired there. This file is the source of truth for the delivered domain: `scripts/instantiate.sh` renders the managed pre-commit block from it, `.pre-commit-hooks.yaml` publishes the same set to consumers who install this repository as a pre-commit repo, and `gates/canon/delivered-domain.sh` holds the three in agreement. A gate under `gates/canon/` is deliberately absent: it checks an invariant only this repository has.",
  "script_root": "gates/instance",
  "instance_root": ".spec-driven-docs/hooks",
  "support": ["lib-instance-paths.sh", "no-self-narration.awk"],
  "gates": [
    {
      "id": "adr-filename-shape",
      "name": "decision record filename shape",
      "script": "adr-filename-shape.sh",
      "files": "^{docs_root}/decisions/.*\\.md$"
    },
    {
      "id": "adr-word-cap",
      "name": "decision record word cap",
      "script": "adr-word-cap.sh",
      "always_run": true
    },
    {
      "id": "agents-digest-size",
      "name": "agent digest size",
      "script": "agents-digest-size.sh",
      "always_run": true
    },
    {
      "id": "chapter-size-cap",
      "name": "chapter and catalog size",
      "script": "chapter-size-cap.sh",
      "always_run": true
    },
    {
      "id": "comparison-dated-tables",
      "name": "comparison tables are dated",
      "script": "comparison-dated-tables.sh",
      "files": "(^|/)COMPARISON-[a-z0-9-]+\\.md$"
    },
    {
      "id": "comparison-escaped-pipes",
      "name": "comparison table pipes are escaped",
      "script": "comparison-escaped-pipes.sh",
      "files": "(^|/)COMPARISON-[a-z0-9-]+\\.md$"
    },
    {
      "id": "comparison-legend",
      "name": "comparison legend",
      "script": "comparison-legend.sh",
      "files": "(^|/)COMPARISON-[a-z0-9-]+\\.md$"
    },
    {
      "id": "comparison-one-reference-per-cell",
      "name": "one reference per comparison cell",
      "script": "comparison-one-reference-per-cell.sh",
      "files": "(^|/)COMPARISON-[a-z0-9-]+\\.md$"
    },
    {
      "id": "comparison-verdict-word",
      "name": "comparison verdict word",
      "script": "comparison-verdict-word.sh",
      "files": "(^|/)COMPARISON-[a-z0-9-]+\\.md$"
    },
    {
      "id": "gate-message-cites-a-rule",
      "name": "gate messages cite a rule",
      "script": "gate-message-cites-a-rule.sh",
      "always_run": true
    },
    {
      "id": "instance-manifest",
      "name": "instance manifest",
      "script": "instance-manifest.sh",
      "always_run": true
    },
    {
      "id": "ki-bugzilla-report-width",
      "name": "Bugzilla report width",
      "script": "ki-bugzilla-report-width.sh",
      "always_run": true
    },
    {
      "id": "ki-filename-shape",
      "name": "known issue filename shape",
      "script": "ki-filename-shape.sh",
      "files": "^{docs_root}/reference/known-issues/.*\\.md$"
    },
    {
      "id": "ki-mechanism-walkthrough",
      "name": "known issue mechanism walkthrough",
      "script": "ki-mechanism-walkthrough.sh",
      "always_run": true
    },
    {
      "id": "ki-report-body",
      "name": "known issue report body",
      "script": "ki-report-body.sh",
      "always_run": true
    },
    {
      "id": "ki-retire-when",
      "name": "known issue retirement condition",
      "script": "ki-retire-when.sh",
      "always_run": true
    },
    {
      "id": "no-self-narration",
      "name": "documents state the present",
      "script": "no-self-narration.sh",
      "types": ["markdown"],
      "exclude": "^{docs_root}/decisions/"
    },
    {
      "id": "spec-requirement-parts",
      "name": "spec requirement parts",
      "script": "spec-requirement-parts.sh",
      "files": "^{docs_root}/specs/SPEC-.*\\.md$"
    },
    {
      "id": "spec-rule-id-unique",
      "name": "spec rule IDs are unique",
      "script": "spec-rule-id-unique.sh",
      "always_run": true
    },
    {
      "id": "spec-size-cap",
      "name": "spec size cap",
      "script": "spec-size-cap.sh",
      "always_run": true
    },
    {
      "id": "spec-verify-hooks-exist",
      "name": "spec hook references exist",
      "script": "spec-verify-hooks-exist.sh",
      "always_run": true
    },
    {
      "id": "suppression-names-its-case",
      "name": "suppressions name a known issue",
      "script": "suppression-names-its-case.sh",
      "always_run": true
    }
  ]
}
